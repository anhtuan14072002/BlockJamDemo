.level-editor {
    padding: 12px;
}

.hidden {
    display: none;
}

.tab-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.tab-button {
    min-width: 100px;
    margin-right: 6px;
}

.title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.section-title {
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 4px;
}

.grid-fields {
    flex-direction: row;
}

.field {
    margin-bottom: 4px;
}

.grid-field {
    flex-grow: 1;
    margin-right: 8px;
}

.grid-scroll {
    min-height: 160px;
    max-height: 360px;
    background-color: rgb(31, 34, 38);
    padding: 8px;
}

.grid-holder {
    flex-grow: 1;
    align-items: center;
}

.grid-preview {
    flex-direction: column;
}

.grid-cell-label {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.block-summary {
    margin-bottom: 6px;
}

.block-summary-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.block-summary-total {
    margin-bottom: 2px;
    padding-top : 15px;
    padding-bottom: 15px;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.block-summary-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    width: 25%;
}

.block-summary-swatch {
    width: 12px;
    height: 12px;
    margin-right: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(80, 86, 94);
    border-bottom-color: rgb(80, 86, 94);
    border-left-color: rgb(80, 86, 94);
    border-right-color: rgb(80, 86, 94);
}

.button-row {
    flex-direction: row;
    margin-top: 12px;
}

.button-row > Button {
    min-width: 110px;
    margin-right: 8px;
}

.environment-buttons {
    margin-top: 6px;
    margin-bottom: 6px;
}

.environment-buttons > Button {
    min-width: 100px;
}

.material-fields {
    margin-top: 8px;
}
